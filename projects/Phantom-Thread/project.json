    },
    {
      "i": 3,
      "start": 5.0,
      "end": 7.2,
      "speaker": "m",
      "text": "أنا راجل اتخلقت للعزوبية",
      "take": "c03_m.wav"
    },
    {
      "i": 4,
      "start": 7.7,
      "end": 9.0,
      "speaker": "m",
      "text": "ومفيش علاج لده",
      "take": "c04_m.wav"
    },
    {
      "i": 5,
      "start": 9.7,
      "end": 11.3,
      "speaker": "m",
      "text": "الجواز هيخليني كدّاب",
