{
  "slug": "Bob-Proctor-5min-2v",
  "title": "Bob Proctor — أول 5 دقائق (صوتان)",
  "source_name": "",
  "lang": "ar",
  "dialect": "msa",
  "created_at": "2026-08-28T18:44:21+00:00",
  "cues": [
    {
      "i": 1,
      "start": 0.45,
      "end": 8.43,
      "speaker": "i",
      "text": "حضرت ندوات كثيرة، وقلت إن سببك كان أن تتعرّف على نفسك أكثر. وتجربتي أن الناس يحضرون الندوات"
    },
    {
      "i": 2,
      "start": 8.79,
      "end": 11.91,
      "speaker": "i",
      "text": "وخاصة ندوات التطوير، بحثاً عن إجابة"
    },
    {
      "i": 3,
      "start": 12.72,
      "end": 17.13,
      "speaker": "i",
      "text": "عمّا في الخارج أتعلّمه لأنجح أكثر. ألم يكن هذا دافعك؟"
    },
    {
      "i": 4,
      "start": 17.31,
      "end": 24.99,
      "speaker": "p",
      "text": "لا. أظنك محق، هذا ما يبحث عنه معظم الناس: إجابة خارج أنفسهم، ولن يجدوها أبداً"
    },
    {
      "i": 5,
      "start": 26.61,
      "end": 34.35,
      "speaker": "p",
      "text": "مع الوقت أدركت أن الأمر شيء بداخلي. قابلت رجلاً هنا في تورونتو، هو من أدخلني هذا المجال"
    },
    {
      "i": 6,
      "start": 34.92,
      "end": 42.18,
      "speaker": "p",
      "text": "وقال لي: إن لم تعجبك النتائج التي تحصل عليها في حياتك، فعليك أن تغيّر نفسك، لأنها نتائجك أنت"
    },
    {
      "i": 7,
      "start": 42.87,
      "end": 46.26,
      "speaker": "p",
      "text": "وقال: إن أردت أن تتغيّر، عليك أن تكتشف شيئاً عن نفسك"
    },
    {
      "i": 8,
      "start": 47.16,
      "end": 48.6,
      "speaker": "p",
      "text": "وبدا هذا منطقياً"
    },
    {
      "i": 9,
      "start": 50.16,
      "end": 59.43,
      "speaker": "p",
      "text": "لم تكن فكرة تهزّ الأرض، لكنها كانت منطقية جداً لي. فبدأت أدرس نفسي، ووجدت أن معظم الناس لا يعرفون من هم"
    },
    {
      "i": 10,
      "start": 60.0,
      "end": 60.75,
      "speaker": "p",
      "text": "فعلاً لا"
    },
    {
      "i": 11,
      "start": 61.68,
      "end": 65.04,
      "speaker": "i",
      "text": "من أنا؟ أعرف اسمي وعمري وأين أعيش، لكن هذا ليس أنا"
    },
    {
      "i": 12,
      "start": 65.13,
      "end": 67.2,
      "speaker": "p",
      "text": "هذه أشياء تعرفها"
    },
    {
      "i": 13,
      "start": 67.2,
      "end": 68.22,
      "speaker": "i",
      "text": "لو سألت أحداً"
    },
    {
      "i": 14,
      "start": 68.22,
      "end": 72.45,
      "speaker": "p",
      "text": "لو سألت أي شخص عادي من هو، فسيعطيك اسمه"
    },
    {
      "i": 15,
      "start": 72.9,
      "end": 78.78,
      "speaker": "p",
      "text": "بوب بروكتور، كلمتان منحني إياهما والداي. تُسمّى أسماء، لكنها ليست أنا، إنها اسمي"
    },
    {
      "i": 16,
      "start": 79.5,
      "end": 87.15,
      "speaker": "p",
      "text": "ثم تقول: ربما هذا ليس أنا أيضاً، هذا جسدي. أنت لا تتصل بالاستوديو لتقول: الجسد لن يأتي، إنه مريض"
    },
    {
      "i": 17,
      "start": 88.09,
      "end": 93.63,
      "speaker": "p",
      "text": "نحن لا نقول أنا اليد أو أنا الساق، بل نقول يدي وساقي وجسدي واسمي"
    },
    {
      "i": 18,
      "start": 94.41,
      "end": 94.98,
      "speaker": "p",
      "text": "وعقلي"
    },
    {
      "i": 19,
      "start": 95.76,
      "end": 102.51,
      "speaker": "p",
      "text": "إذاً من أنا؟ سؤال مثير، وأؤمن أن من يدرس ويبحث عن الإجابة سيجدها"
    },
    {
      "i": 20,
      "start": 103.83,
      "end": 111.06,
      "speaker": "p",
      "text": "أظن أننا نعيش على ثلاثة مستويات: نحن كائنات روحية، لنا عقل، ونعيش في أجساد"
    },
    {
      "i": 21,
      "start": 112.17,
      "end": 120.54,
      "speaker": "p",
      "text": "ولأننا نفتقر إلى الوعي بمن نحن، ندخل هذا العالم المادي ونترك ما حولنا يتحكّم بنا تماماً"
    },
    {
      "i": 22,
      "start": 120.99,
      "end": 125.85,
      "speaker": "p",
      "text": "خمسة وتسعون بالمئة يتفاعلون مع الحياة، لا يعيشونها"
    },
    {
      "i": 23,
      "start": 125.85,
      "end": 127.17,
      "speaker": "i",
      "text": "وما هي عوائق النجاح؟"
    },
    {
      "i": 24,
      "start": 127.17,
      "end": 132.0,
      "speaker": "p",
      "text": "النجاح كلمة غريبة فعلاً"
    },
    {
      "i": 25,
      "start": 133.14,
      "end": 138.09,
      "speaker": "p",
      "text": "نايتنغيل عرّفه تعريفاً رائعاً: الناجح من يعرف أين هو"
    },
    {
      "i": 26,
      "start": 138.57,
      "end": 149.64,
      "speaker": "p",
      "text": "ويعرف إلى أين يمضي، ويتقدّم في ذلك الاتجاه باستمرار. قال إن النجاح هو التحقيق التدريجي لهدف نبيل. وكل من له هدف ويتحرّك نحوه فهو ناجح"
    },
    {
      "i": 27,
      "start": 150.48,
      "end": 157.59,
      "speaker": "p",
      "text": "يظن معظم الناس أنك ناجح إن ملكت مالاً كثيراً. غالباً تملك المال إن نجحت، لكن الأم تيريزا"
    },
    {
      "i": 28,
      "start": 158.16,
      "end": 161.49,
      "speaker": "p",
      "text": "لم تملك مالاً، ومع ذلك كانت ناجحة جداً"
    },
    {
      "i": 29,
      "start": 162.3,
      "end": 163.14,
      "speaker": "p",
      "text": "إذاً"
    },
    {
      "i": 30,
      "start": 163.95,
      "end": 165.33,
      "speaker": "i",
      "text": "وما هذا العائق؟"
    },
    {
      "i": 31,
      "start": 165.33,
      "end": 173.85,
      "speaker": "p",
      "text": "هناك عائقان: الأول هو البرمجة التي تحدث في عقلنا الباطن منذ أن كنّا رضّعاً"
    },
    {
      "i": 32,
      "start": 174.54,
      "end": 180.12,
      "speaker": "p",
      "text": "كل ما نستطيعه أن نتصرّف ونتكلّم مثل من حولنا، ولهذا نتعلّم اللغة"
    },
    {
      "i": 33,
      "start": 180.72,
      "end": 185.04,
      "speaker": "p",
      "text": "لو نُطقت عشر لغات في بيتنا لتعلّمناها كلها بلا عناء"
    },
    {
      "i": 34,
      "start": 186.06,
      "end": 194.94,
      "speaker": "p",
      "text": "لكن عادةً واحدة فقط، وحين نكبر نظن أننا لا نستطيع تعلّم غيرها. نستطيع لو أردنا، لكننا مبرمجون"
    },
    {
      "i": 35,
      "start": 195.84,
      "end": 199.14,
      "speaker": "p",
      "text": "برمجة قوية جداً، ومعها أفكار جيدة"
    },
    {
      "i": 36,
      "start": 200.49,
      "end": 208.56,
      "speaker": "p",
      "text": "وهذا العائق الداخلي. أما الخارجي فهو بيئتنا، فلدينا ميل لأن نتصرّف مثل كل من حولنا"
    },
    {
      "i": 37,
      "start": 210.09,
      "end": 218.73,
      "speaker": "p",
      "text": "وإن فكّرت تجده منطقياً، فالإحصاءات تقول إن خمسة وتسعين بالمئة يعيشون حياتهم دون أن يعيشوا كما يريدون"
    },
    {
      "i": 38,
      "start": 219.96,
      "end": 231.0,
      "speaker": "p",
      "text": "خمسة وتسعون بالمئة من سكان أمريكا الشمالية، أغنى بلد في التاريخ، يعملون بإنتاجية أربعين سنة من أصل خمس وستين"
    },
    {
      "i": 39,
      "start": 231.6,
      "end": 233.19,
      "speaker": "p",
      "text": "وينتهون بلا مال"
    },
    {
      "i": 40,
      "start": 234.85,
      "end": 236.01,
      "speaker": "p",
      "text": "لا بد أن هناك خطأ"
    },
    {
      "i": 41,
      "start": 237.0,
      "end": 241.2,
      "speaker": "p",
      "text": "خمسة بالمئة فقط ينتهون بوضع مالي مريح"
    },
    {
      "i": 42,
      "start": 242.67,
      "end": 245.61,
      "speaker": "i",
      "text": "هل تحاول أن تُحبطني؟ لا"
    },
    {
      "i": 43,
      "start": 245.61,
      "end": 251.73,
      "speaker": "p",
      "text": "بل أظنها فكرة مثيرة، فالفكرة خلفها أن أي أحد يستطيع أن يفوز"
    },
    {
      "i": 44,
      "start": 252.51,
      "end": 260.04,
      "speaker": "p",
      "text": "أي أحد. لكن حين ندرس هذه الإحصاءات نصل إلى نتيجة: يجدر بي أن أفكّر بنفسي بدل أن أتبع الجميع"
    },
    {
      "i": 45,
      "start": 260.7,
      "end": 268.44,
      "speaker": "p",
      "text": "معظم الناس يجدون وظيفة، وينظرون حولهم، ويعملون كما يعمل الآخرون. عليهم أن يتوقفوا ويسألوا: هل يعرف هؤلاء ما يفعلون؟"
    },
    {
      "i": 46,
      "start": 269.64,
      "end": 270.78,
      "speaker": "p",
      "text": "هل من طريقة أفضل؟"
    },
    {
      "i": 47,
      "start": 270.9,
      "end": 276.21,
      "speaker": "i",
      "text": "ألسنا نحتاج أن ننسجم؟ لا نريد أن نبرز، ولا أن نُطرد، ولا نصنع الأمواج"
    },
    {
      "i": 48,
      "start": 276.72,
      "end": 283.8,
      "speaker": "p",
      "text": "تماماً. اصطفّ فقط وكن مثل الجميع. هذا رائع في مملكة الحيوان"
    },
    {
      "i": 49,
      "start": 285.39,
      "end": 288.78,
      "speaker": "p",
      "text": "لكن البشر لا يعيشون هكذا. علينا أن نصنع بعض الأمواج"
    },
    {
      "i": 50,
      "start": 289.38,
      "end": 297.27,
      "speaker": "p",
      "text": "علينا أن نبرز وأن نكون مختلفين، لا لمجرد الاختلاف بل لأننا مختلفون فعلاً ونفكّر أفكاراً مختلفة"
    },
    {
      "i": 51,
      "start": 297.96,
      "end": 299.67,
      "speaker": "p",
      "text": "وأؤمن أن علينا أن نفكّر"
    },
    {
      "i": 52,
      "start": 300.18,
      "end": 309.12,
      "speaker": "p",
      "text": "وأن نبني صوراً في عقولنا لما نريد فعله ثم نفعله. إمرسون فعل ذلك، وإديسون، وماركوني، وصمويل مورس"
    }
  ],
